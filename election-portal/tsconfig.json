{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "server/models/**",
    "server/controllers/**",
    "server/db/**",
    "server/storage.ts",
    "server/config/**",
    "server/routes/**",
    "client/src/pages/VotingInterface.tsx",
    "client/src/pages/ElectionGroups.tsx",
    "client/src/lib/mockData.ts",
    "client/src/components/voting/BallotForm.tsx",
    "client/src/components/nominees/NomineeCard.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2020",
    "downlevelIteration": true,
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
