# ─────────────────────────────────────────────────────────────────────────────
# election-portal — environment variables
# Copy this file to .env and fill in the values before starting the dev server.
# Never commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the election-api backend (no trailing slash). Required.
# Must match election-api PORT.
VITE_API_URL=http://localhost:5000
# Production / shared API (DigitalOcean) — only after election-api is redeployed with Supabase:
# VITE_API_URL=https://election-api-vbpil.ondigitalocean.app

# Port for the local portal (Express + Vite). Required.
# Must match election-api FRONTEND_URL.
VITE_PORT=5173

# ── Netlify production ─────────────────────────────────────────────────────────
# Netlify builds a static SPA (npm run build → dist/public).
# The client calls VITE_API_URL directly, so set it at build time:
#   VITE_API_URL=https://your-election-api-host
# election-api FRONTEND_URL must be the Netlify site origin.
